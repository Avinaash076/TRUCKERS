DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
OSRM_URL=https://router.project-osrm.org
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Adding a key automatically selects WeatherAPI instead of Open-Meteo.
WEATHERAPI_KEY=
# Optional explicit override: WEATHER_PROVIDER=weatherapi or open_meteo
GEOCODER_URL=https://nominatim.openstreetmap.org/search
PROVIDER_USER_AGENT=WeatherHaul-assessment/1.0
# Set this in Render frontend build environment; leave empty for Vite proxy locally.
VITE_API_URL=
